          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "title": "Entry TCP: share of configs reachable per node",
      "type": "timeseries",
      "description": "One line per node: the share of configs whose server address accepts a plain TCP connection from the node, with no xray in between. Low here means the address or port is blocked from that node; high here with a failing tunnel means the protocol is blocked."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
