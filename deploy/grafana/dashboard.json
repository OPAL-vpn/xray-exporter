          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "xray_control_up{instance=\"$node\"}",
          "refId": "A",
          "legendFormat": "{{class}}/{{kind}}/{{name}}"
        }
      ],
      "title": "Direct controls: details for $node",
      "type": "state-timeline",
      "description": "Each direct probe of the node picked in the Node variable. Class is domestic or foreign: domestic up with foreign down looks like a whitelist regime, everything down is a dead line."
    },
    {
      "datasource": {
        "type": "prometheus",
